# Base path. The site is served inside the Serene Heights Group site at /serene-investors (Next.js
# Multi-Zones). Leave unset for "/serene-investors"; set to an empty value only to run at the root.
# NEXT_PUBLIC_BASE_PATH=/serene-investors

# The group site (footer "Serene Heights Group" link). "/" is right when served inside it.
# NEXT_PUBLIC_GROUP_URL=/

# Resend API key for OTP sign-in emails (/serene-investors/api/auth/send-otp).
RESEND_API_KEY=
